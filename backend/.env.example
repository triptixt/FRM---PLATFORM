# Server
PORT=8081
NODE_ENV=development

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=frm_user
DB_PASSWORD=frm_pass123
DB_NAME=frm_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_KEY_PREFIX=frm:
REDIS_FAIL_OPEN=true

# Security
JWT_SECRET=frm-super-secret-jwt-key-change-this-in-production-2026
JWT_EXPIRY_MS=86400000

# FRM Decision Engine Thresholds
APPROVE_BELOW=40
REVIEW_BELOW=70
BLOCK_FROM=70
RULE_CACHE_INTERVAL_MS=60000
